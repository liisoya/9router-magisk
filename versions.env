# 唯一版本源 —— 跟随上游只需要改 APP_VERSION
# 更新方式: tools/check-update.sh （打印上游最新版，不改本文件）

# 本仓库（用于生成 module.prop 的 updateJson 与 Release 下载地址）
GITHUB_REPO=liisoya/9router-magisk
ZIP_BASENAME=9router-Magisk

APP_VERSION=0.5.75
MODULE_REV=5

# 安卓 Node 运行时（来自 Termux 官方源，bionic / arm64）
NODE_PACKAGE=nodejs-lts
NODE_VERSION=24.18.0-1

TERMUX_ARCH=aarch64
TERMUX_REPO=https://packages.termux.dev/apt/termux-main
TERMUX_DIST=stable

# 需要打进运行时的依赖包: "<包名> <版本>"
TERMUX_DEBS="
openssl 1:3.6.3
libicu 78.3
libc++ 29
c-ares 1.34.8
libsqlite 3.53.4
zlib 1.3.2
ca-certificates 1:2026.08.13
"

# 网络不通时使用: export PROXY=socks5://127.0.0.1:7890
PROXY=${PROXY:-}

# 运行时/应用端口
APP_PORT=20128
UI_PORT=20129
